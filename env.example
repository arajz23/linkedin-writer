# Lua API key (optional; the CLI keychain session is used otherwise)
# LUA_API_KEY=

# Who the agent works for. Defaults to the email in src/knowledge/owner.ts; OWNER_USER_IDS is optional.
# OWNER_EMAILS=you@example.com
# OWNER_USER_IDS=

# Set to 1 when running workflows locally: steps that email or write posts then skip the real effect.
# LINKEDIN_DRY_RUN=1

# Gmail label the intake reads newsletters from (Substack and others). Optional.
# READING_LABEL=LinkedIn Reading
